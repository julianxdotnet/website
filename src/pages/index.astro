---
import "../styles/global.css";
import { dailyJapanWisdom, justWisdom, socials, work } from "@/data/site";

const title = "Julian";
const description = "Julian: entertainment, technology, AI, Japan, and daily wisdom.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site">
      <nav class="topnav" aria-label="Primary">
        <a class="brand" href="/" aria-label="Julian home">Julian</a>
        <div class="navlinks">
          <a href="#work">Work</a>
          <a href="#dailyjapanwisdom">DJW</a>
          <a href="#justwisdom">Wisdom</a>
        </div>
      </nav>

      <main>
        <section class="hero" aria-labelledby="intro-title">
          <p class="kicker">ジュリアンです</p>
          <h1 id="intro-title">Hi, I'm Julian.</h1>
          <div class="statement">
            <p>Building where entertainment meets technology, from the early internet to AI. Global perspective, Tokyo base, lifelong learner. Team humanity.</p>
            <p lang="ja">異文化理解力を大切に、東京を拠点に、インターネット黎明期からAIまで、エンターテインメントとテクノロジーの交差点で歩んできました。</p>
          </div>

          <ul class="social-list" aria-label="Socials">
            {socials.map((social) => <li><a href={social.href}>{social.label}</a></li>)}
          </ul>
        </section>

        <hr class="rule" />

        <section id="work" class="section" aria-labelledby="work-title">
          <h2 id="work-title">Work</h2>
          <p class="section-intro">A path through media, streaming, big tech, startups, and AI.</p>
          <ul class="work-list" role="list">
            {work.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <hr class="rule" />

        <section id="dailyjapanwisdom" class="section" aria-labelledby="djw-title">
          <div class="section-head">
            <div>
              <h2 id="djw-title">DailyJapanWisdom</h2>
              <p class="section-intro">Recent Japanese wisdom posts.</p>
            </div>
            <a class="section-link" href="https://dailyjapanwisdom.com">dailyjapanwisdom.com</a>
          </div>

          <ol class="post-list">
            {dailyJapanWisdom.map((item) => (
              <li>
                <a class="post-row" href={item.href}>
                  <div>
                    <h3>{item.quote}</h3>
                    <p class="reading">{item.reading}</p>
                    <p>{item.english}</p>
                  </div>
                  <span>{item.date}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>

        <hr class="rule" />

        <section id="justwisdom" class="section" aria-labelledby="jw-title">
          <h2 id="jw-title">JustWisdom</h2>
          <ol class="post-list wisdom-list">
            {justWisdom.map((item) => (
              <li>
                <article class="post-row wisdom-row">
                  <div>
                    <h3>“{item.quote}”</h3>
                    <p>{item.attribution}</p>
                  </div>
                </article>
              </li>
            ))}
          </ol>
        </section>

        <hr class="rule" />

        <section class="section" aria-labelledby="tokyo-title">
          <h2 id="tokyo-title">Off the Beaten Track Tokyo</h2>
          <p class="section-intro">A personal map list for quiet corners, small discoveries, and Tokyo places worth returning to.</p>
        </section>
      </main>

      <footer>
        <span>© 2026 Julian</span>
      </footer>
    </div>
  </body>
</html>
