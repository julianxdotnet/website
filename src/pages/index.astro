---
import "../styles/global.css";
import { dailyJapanWisdom, socials, work } from "@/data/site";

const title = "Julian";
const description = "Julian: entertainment, technology, AI, Japan, and daily wisdom.";
const socialHref = Object.fromEntries(socials.map((social) => [social.label, social.href]));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="site-title" href="/">Julian</a>
        <nav class="site-nav" aria-label="Primary">
          <a href="#posts">Posts</a>
          <a href="#about">About</a>
          <a href="#search" aria-label="Search">⌕</a>
          <span class="theme-dot" aria-hidden="true"></span>
        </nav>
      </header>

      <main id="main">
        <section class="intro" aria-labelledby="intro-title">
          <p class="eyebrow">ジュリアンです</p>
          <h1 id="intro-title">Hi, I'm Julian.</h1>
          <a class="rss-link" href="https://dailyjapanwisdom.com">DailyJapanWisdom</a>

          <p>
            I’ve built my career around big technology shifts: the early internet,
            digital distribution, streaming, blockchain and now AI. Always at the
            crossroads of media and technology.
          </p>
          <p>
            インターネット黎明期、デジタル配信、ストリーミング、ブロックチェーン、そしてAIまで。
            メディアとテクノロジーの交差点でキャリアを築いてきました。
          </p>

          <ul class="social-links" aria-label="Social links">
            <li>
              <a href={socialHref.Twitter} aria-label="Julian on X">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 2h3.3l-7.3 8.3L23.5 22h-6.7l-5.2-6.8L5.6 22H2.3l7.8-8.9L1.8 2h6.9l4.7 6.2L18.9 2Zm-1.2 18h1.8L7.7 3.9h-2L17.7 20Z"></path></svg>
              </a>
            </li>
            <li>
              <a href={socialHref.Instagram} aria-label="Julian on Instagram">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm5 3.8A4.2 4.2 0 1 1 12 16.2 4.2 4.2 0 0 1 12 7.8Zm0 2A2.2 2.2 0 1 0 12 14.2 2.2 2.2 0 0 0 12 9.8Zm4.8-3.1a1 1 0 1 1-1 1 1 1 0 0 1 1-1Z"></path></svg>
              </a>
            </li>
            <li>
              <a href={socialHref.LinkedIn} aria-label="Julian on LinkedIn">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.9 8.8H3.6V20h3.3V8.8ZM5.2 7.3a1.9 1.9 0 1 0 0-3.8 1.9 1.9 0 0 0 0 3.8ZM20.4 20h-3.3v-5.8c0-1.4-.5-2.3-1.7-2.3-.9 0-1.5.6-1.7 1.2-.1.2-.1.5-.1.8V20h-3.3s.1-10.1 0-11.2h3.3v1.6c.4-.7 1.2-1.8 3-1.8 2.2 0 3.8 1.4 3.8 4.5V20Z"></path></svg>
              </a>
            </li>
            <li>
              <a href={socialHref.DJW} aria-label="DailyJapanWisdom">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.8A2.8 2.8 0 1 1 12 6.2a2.8 2.8 0 0 1 0 5.6Z"></path></svg>
              </a>
            </li>
          </ul>
        </section>

        <section id="posts" class="post-section" aria-labelledby="posts-title">
          <h2 id="posts-title">Posts</h2>
          <ul class="post-list">
            {dailyJapanWisdom.map((post) => (
              <li class="post-item">
                <a class="post-title" href={post.href}>{post.quote}</a>
                <p class="post-meta">Published: {post.date} <span>•</span> X post</p>
                <p class="post-reading">{post.reading}</p>
                <p>{post.english}</p>
              </li>
            ))}
          </ul>
        </section>

        <section id="about" class="about-section" aria-labelledby="about-title">
          <h2 id="about-title">About</h2>
          <p>
            Film, TV, big tech, startups and AI. London / Paris / Singapore / Los Angeles /
            Philadelphia / Tokyo. English / French / Japanese.
          </p>
          <p class="work-line">{work.join(" / ")}</p>
        </section>
      </main>

      <footer class="site-footer">
        <ul class="footer-links" aria-label="Footer social links">
          <li><a href={socialHref.Twitter}>X</a></li>
          <li><a href={socialHref.LinkedIn}>LinkedIn</a></li>
          <li><a href={socialHref.DJW}>DailyJapanWisdom</a></li>
        </ul>
        <a href="https://github.com/julianxdotnet/website">Code on GitHub</a>
      </footer>
    </div>
  </body>
</html>
